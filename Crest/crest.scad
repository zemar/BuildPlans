module region_2d(region) {
    polygon(points=region[1], paths=region[2], convexity=30);
}

module regions_2d(color_id) {
    union() {
        for (region = vector_regions)
            if (region[0] == color_id)
                region_2d(region);
    }
}

module all_inlays_2d() {
    union() {
        for (color_id = [1:4])
            regions_2d(color_id);
    }
}

module color_part(color_id) {
    floor_z = thickness_mm - inlay_depth_mm;
    if (color_id == 0) {
        // One connected white substrate with exact, matching inlay pockets.
        difference() {
            cylinder(d=source_diameter_mm, h=thickness_mm);
            translate([0,0,floor_z])
                linear_extrude(height=inlay_depth_mm + 0.02, convexity=30)
                    all_inlays_2d();
        }
    } else {
        translate([0,0,floor_z])
            linear_extrude(height=inlay_depth_mm, convexity=30)
                regions_2d(color_id);
    }
}

// Parent assembly. Keep color() on separate children to retain material groups.
module crest() {
    scale([diameter_mm/source_diameter_mm, diameter_mm/source_diameter_mm, 1]) {
        for (color_id = [0:4]) {
            if (part == "all" || part == color_names[color_id])
                color(palette[color_id])
                    color_part(color_id);
        }
    }
}

echo(str("Crest: ", diameter_mm, " x ", diameter_mm, " x ", thickness_mm,
         " mm; five flush vector colors; inlay depth ", inlay_depth_mm,
         " mm; export part=", part));
crest();
