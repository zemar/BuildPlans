/*
  Camel and Panda Crest -- self-contained vector OpenSCAD model.
  Same audited contours as crest.py: Canadian flag, red carpet, bamboo.
  70 mm round x 2 mm; five colors; no outer ring; all artwork flush.
  White substrate: 1.6 mm. Colored inlays: 0.4 mm, ending at Z=2 mm.

  Open in OpenSCAD; F5 preview, F6 render. Export 3MF with model colors.
  Select a single part below for separate filament exports, preserving positions.
  Keep all color parts together as ONE multipart object in the slicer.
  STL cannot carry colors. No external SVG, mesh, library or data files needed.

  OpenSCAD prints diagnostics via echo(); it cannot write a sidecar itself.
  To append diagnostics when using the CLI, redirect stderr to crest.log:
    openscad -O export-3mf/color-mode=model -O export-3mf/material-type=color -o crest-scad.3mf crest.scad 2>>crest.log
*/

/* [Dimensions in millimeters] */
diameter_mm = 70;
thickness_mm = 2;
inlay_depth_mm = 0.4;

/* [Display and export] */
part = "all"; // [all,white,black,brown,red,green]

/* [Hidden] */
source_diameter_mm = 70;
// Multiple of four: the true 70 mm X/Y bounds are retained in the circle mesh.
$fn = 1440;
color_names = ["white", "black", "brown", "red", "green"];
palette = ["#ffffff", "#000000", "#975721", "#d21923", "#70a628"];

assert(diameter_mm > 0, "Diameter must be positive.");
assert(thickness_mm > 0, "Disc thickness must be positive.");
assert(inlay_depth_mm > 0 && inlay_depth_mm < thickness_mm,
       "Inlay depth must leave a positive white substrate.");
assert(part == "all" || len([for (name = color_names) if (name == part) 1]) == 1,
       "Select all, white, black, brown, red, or green.");

